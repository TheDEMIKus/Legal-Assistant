
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# Дополнительные ключи необязательны; без них используется LLM_API_KEY.
# EMBEDDER_API_KEY=
# RERANKER_API_KEY=

LLM_MODEL=deepseek/deepseek-v4.1-flash
EMB_MODEL=baai/bge-m3
RERANKER_MODEL=cohere/rerank-5-fast

DATA_DIR=data
MAX_WORKERS=4

TEMPERATURE=0.1
MAX_TOKENS=3000
MAX_TOKENS_CEILING=12000

TOP_K=20
RERANKER_TOP_N=5
MAX_RERANK_CANDIDATES=40
MAX_RELATED=2

CHUNK_MAX=1200
CHUNK_OVERLAP=150
EMBED_BATCH=64
MAX_ANSWER_CHARS=10000
MAX_REMARKS=3
ANSWER_ATTEMPTS=2
CHAT_ATTEMPTS=3

HTTP_TIMEOUT=60
HTTP_CONNECT_TIMEOUT=10
HTTP_RETRIES=3
